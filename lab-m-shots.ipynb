   "source": [
    "import re\n",
    "\n",
    "client = OpenAI(api_key=OPENAI_API_KEY)\n",
    "\n",
    "def ask(context, question, model=\"gpt-3.5-turbo\", temperature=0):\n",
    "    messages = context + [{'role': 'user', 'content': question}]\n",
    "    response = client.chat.completions.create(model=model, messages=messages, temperature=temperature)\n",
    "    return response.choices[0].message.content.strip()\n",
    "\n",
    "\n",
    "def shots(examples):\n",
    "    \"\"\"Turn (question, answer) pairs into user/assistant turns (the recommended way from class).\"\"\"\n",
    "    turns = []\n",
    "    for question, answer in examples:\n",
    "        turns += [{'role': 'user', 'content': question}, {'role': 'assistant', 'content': answer}]\n",
    "    return turns\n",
    "\n",
    "\n",
    "def evaluate(name, context, dataset, parse):\n",
    "    \"\"\"Ask every question, parse the label out of the answer, report accuracy and exact-format rate.\"\"\"\n",
    "    correct = exact = 0\n",
    "    print(f\"--- {name} ---\")\n",
    "    for text, label in dataset:\n",
    "        raw = ask(context, text)\n",
    "        pred = parse(raw)\n",
    "        correct += pred == label\n",
    "        exact += raw == label\n",
    "        mark = \"OK \" if pred == label else \"BAD\"\n",
    "        print(f\"{mark} expected {label:<9} got {raw[:70]!r}\")\n",
    "    print(f\"accuracy {correct}/{len(dataset)}, exact format {exact}/{len(dataset)}\\n\")\n",
    "    return correct, exact"
   ]
  },
